// Prisma schema for Raya Future Magazine
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Editorial Article Model ───────────────────────────────────────────────
// Stores magazine articles with full editorial metadata, source tracking,
// and review/publish lifecycle. Used by the /admin dashboard and consumed
// by the public magazine's NewsSection component.

model Article {
  // ── Identity & storage ────────────────────────────────────────────────
  id           String   @id @default(cuid())
  slug         String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // ── Editorial content (Arabic) ────────────────────────────────────────
  title        String
  excerpt      String?
  body         String?
  coverImage   String?
  category     String   @default("أخبار المؤسسة")
  tags         String?  // comma-separated

  // ── Editorial lifecycle ───────────────────────────────────────────────
  // draft → pending_review → approved → published
  // rejected records are kept for audit but never displayed publicly.
  status       ArticleStatus @default(DRAFT)

  // ── Source provenance (for imported content) ──────────────────────────
  // Tracks where the article came from to support idempotent imports.
  sourcePlatform  String? // "facebook" | "website" | "manual" | "import"
  sourceId        String? // stable ID from source (e.g. FB post ID)
  sourceUrl       String?
  originalText   String?  // untouched source text (preserved for audit)
  originalPubAt  DateTime? // original publication date at source
  importedAt     DateTime?

  // ── Editorial tracking ────────────────────────────────────────────────
  authorId      String?
  reviewerId    String?
  reviewedAt    DateTime?
  publishedAt   DateTime?

  // ── Duplicate detection (optional fingerprint of source content) ──────
  contentHash   String?

  @@index([status, publishedAt])
  @@index([sourcePlatform, sourceId])
  @@index([category])
}

enum ArticleStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
}

// ─── User Model ─────────────────────────────────────────────────────────
// Supports three user types:
//   - admin:   full access (master password or admin account)
//   - editor:  editorial team (email + password login)
//   - student: students who register with their student code

model User {
  id           String   @id @default(cuid())
  email        String?  @unique  // optional for students (they use studentCode)
  studentCode  String?  @unique  // required for students (e.g. "RAYA-2026-001")
  name         String?
  role         String   @default("editor")  // "admin" | "editor" | "student"
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
  @@index([studentCode])
}

// ─── Contact Messages ───────────────────────────────────────────────────
// Stores messages submitted through the public contact form.

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  phone     String?
  status    String   @default("new")  // "new" | "read" | "replied" | "archived"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}
